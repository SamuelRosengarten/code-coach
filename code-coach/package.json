{
  "name": "code-coach",
  "displayName": "code-coach",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.129.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeCoach",
          "title": "Code Coach",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeCoach": [
        {
          "id": "codeCoach.statsView",
          "name": "Stats",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeCoach.refreshStats",
        "title": "Refresh Stats",
        "icon": "$(refresh)",
        "category": "Code Coach"
      },
      {
        "command": "codeCoach.manageMutedHints",
        "title": "Manage Muted Hints",
        "category": "Code Coach"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeCoach.refreshStats",
          "when": "view == codeCoach.statsView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
