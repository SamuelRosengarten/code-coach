{
  "name": "code-coach-ai",
  "displayName": "Code Coach AI",
  "description": "A gentle coaching companion that explains your coding mistakes in plain language, tracks patterns over time, and helps you learn faster.",
  "version": "0.0.2",
  "publisher": "samuelrosengarten",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamuelRosengarten/code-coach.git",
    "directory": "code-coach"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Linters",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeCoach",
          "title": "Code Coach",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeCoach": [
        {
          "id": "codeCoach.statsView",
          "name": "Stats",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codeCoach.refreshStats",
        "title": "Refresh Stats",
        "icon": "$(refresh)",
        "category": "Code Coach"
      },
      {
        "command": "codeCoach.manageMutedHints",
        "title": "Manage Muted Hints",
        "category": "Code Coach"
      },
      {
        "command": "codeCoach.setApiKey",
        "title": "Set Claude API Key",
        "category": "Code Coach"
      },
      {
        "command": "codeCoach.clearApiKey",
        "title": "Clear Claude API Key",
        "category": "Code Coach"
      }
    ],
    "configuration": {
      "title": "Code Coach",
      "properties": {
        "codeCoach.hintProvider": {
          "type": "string",
          "enum": [
            "off",
            "claude",
            "local"
          ],
          "enumDescriptions": [
            "Use only the built-in rule-based hints. No setup, no cost.",
            "Reword hints with the Claude API. Requires your own Anthropic API key (run \"Code Coach: Set Claude API Key\").",
            "Reword hints with a locally-running model via Ollama. Requires Ollama installed and running."
          ],
          "default": "off",
          "description": "How Code Coach generates the hint text shown next to errors."
        },
        "codeCoach.localHintEndpoint": {
          "type": "string",
          "default": "http://localhost:11434/api/generate",
          "description": "Endpoint for the local model server, used when codeCoach.hintProvider is \"local\"."
        },
        "codeCoach.localHintModel": {
          "type": "string",
          "default": "llama3.2",
          "description": "Model name to request from the local model server, used when codeCoach.hintProvider is \"local\"."
        },
        "codeCoach.muteSuggestionThreshold": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 50,
          "description": "How many times a mistake type has to be seen within codeCoach.muteSuggestionWindowMinutes before Code Coach offers to mute its hint."
        },
        "codeCoach.muteSuggestionWindowMinutes": {
          "type": "number",
          "enum": [
            2,
            5,
            10
          ],
          "default": 5,
          "description": "The time window, in minutes, that codeCoach.muteSuggestionThreshold hits are counted within."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "codeCoach.refreshStats",
          "when": "view == codeCoach.statsView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  }
}
